{
  "name": "@ethonline/access",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.mjs",
  "bin": {
    "ethonline-access": "./src/cli.mjs",
    "ethonline-access-mcp": "./src/mcp.mjs"
  },
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  },
  "scripts": {
    "test": "npm run build:viewer && node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "npm run build:viewer && node --test --test-concurrency=1 test/viewer.test.mjs test/viewer-cancel.test.mjs",
    "check": "node scripts/check-syntax.mjs && npm test",
    "check:handoff": "node scripts/check-reviewed-handoff.mjs",
