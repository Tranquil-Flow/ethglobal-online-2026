{
  "name": "@ethonline/indexing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  },
  "exports": "./src/index.mjs",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "codegen": "graph codegen subgraph/subgraph.yaml --output-dir subgraph/generated",
    "build": "graph build subgraph/subgraph.yaml",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/syntax.mjs && node scripts/metadata-vectors.mjs && npm run compile && npm run codegen && npm run build && npm test && npm run test:mapping",
    "test:mapping": "cd subgraph && ../node_modules/.bin/graph test -v 0.6.0",
    "smoke": "node scripts/smoke.mjs",
    "smoke:ingestion": "node scripts/ingestion.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs",
    "history": "node scripts/history.mjs",
    "smoke:live": "node scripts/live-smoke.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "fs-ext": "2.1.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "matchstick-as": "0.6.0",
    "solc": "0.8.36",
    "yaml": "2.9.0"
  },
  "overrides": {
    "cross-spawn@7": "7.0.6",
    "ejs@3": "3.1.10",
    "semver@7": "7.8.5",
    "tmp": "0.2.7",
    "glob@11": "11.1.0",
    "immutable@5": "5.1.9",
    "js-yaml@4": "4.3.2",
    "undici@7": "7.29.1",
    "yaml": "$yaml"
  }
}
