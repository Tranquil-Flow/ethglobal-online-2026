{
  "name": "ethglobal-online-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "start": "node composition/serve.mjs",
    "mcp": "node composition/mcp.mjs",
    "operator": "node composition/application-operator-cli.mjs",
    "demo:application": "node composition/application-demo.mjs",
    "start:workbench": "node composition/serve.mjs --config composition/workbench.example.json",
    "replay": "node composition/replay.mjs",
    "test": "npm --prefix packages/contracts test",
    "check": "npm --prefix packages/contracts run check && node scripts/check-layout.mjs && node --test scripts/test-gates.test.mjs scripts/test-handoff.test.mjs scripts/test-runtime.test.mjs",
    "check:lane": "node scripts/check-lane.mjs",
    "check:all": "node scripts/check-all.mjs",
    "smoke:integration": "node scripts/check-composition.mjs",
    "check:executor": "node --test conformance/executor-port.test.mjs composition/test/executor.test.mjs",
    "check:operations": "npm --prefix operations run check && npm --prefix operations run smoke && node --test composition/test/backup.test.mjs",
    "check:local-services": "node --test composition/test/local-services.test.mjs",
    "serve:application:https": "node composition/application-https.mjs"
  }
}
